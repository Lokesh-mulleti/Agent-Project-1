# ==============================================
# AI Tool-Calling Assistant Configuration
# ==============================================

# LLM Provider Options: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Settings (Required if LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# OpenAI API Settings (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Custom OpenAI Base URL (Optional - for Ollama, Groq, OpenRouter, LocalAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agent Execution Parameters
TEMPERATURE=0.2
MAX_ITERATIONS=10
DEBUG_MODE=false
